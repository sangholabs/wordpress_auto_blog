# [사용법] 이 파일을 복사해서 .env 로 만들고 값을 채운다. .env 는 .gitignore 처리되어 커밋되지 않는다.
#   Windows: copy .env.example .env
#   macOS:   cp .env.example .env
# 필요한 블록만 채우면 된다. 코드는 채워진 값에 맞춰 자동 동작한다.

# === 글 생성 LLM (필수) =========================================
# claude_code : 로컬 Claude Code CLI + 구독 로그인 사용(키 불필요). 기본값. SETUP.md 3단계 참고.
# gemini      : GEMINI_API_KEY 필요(무료 등급 가능).
# anthropic   : ANTHROPIC_API_KEY 필요(유료 API).
LLM_PROVIDER=claude_code
GEMINI_API_KEY=           # [선택] LLM_PROVIDER=gemini 일 때만
ANTHROPIC_API_KEY=        # [선택] LLM_PROVIDER=anthropic 일 때만

# === 국가정책·티스토리 작업실 ==================================
# 보조금24 후보 자동 수집용. 공공데이터포털에서 아래 API 활용신청 후 표시되는 일반 인증키를 입력한다.
# https://www.data.go.kr/data/15113968/openapi.do
DATA_GO_KR_API_KEY=
# 정책 글 대표/본문 이미지 3장 생성용 OpenAI 유료 API 키. ChatGPT/Codex 구독과 별도 과금된다.
OPENAI_API_KEY=

# === 쿠팡 파트너스 ==============================================
# [선택] 트래킹 ID. 검색 링크 폴백에 쓰인다.
COUPANG_PARTNERS_TAG=
# [선택] 최종 승인(판매금액 15만원) 후에만 발급되는 Open API 키. 있으면 실상품 카드로 자동 전환.
#   승인 전이면 비워두고 config/coupang_widget.html 로 다이나믹 배너를 쓴다. (SETUP.md 4-1 참고)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# === WordPress 게시 (설치형 WordPress.org, 카페24 등) ===========
# [필수: 게시 단계] 사이트 주소 + 관리자 아이디 + Application Password. 발급법은 SETUP.md 6단계 참고.
WP_SITE_URL=             # 예) https://myblog.com (https 필수)
WP_USERNAME=             # 워드프레스 관리자 아이디
WP_APP_PASSWORD=         # 관리자 프로필에서 발급한 Application Password (xxxx xxxx ... 형식)

# === 사이트 정보 (애드센스 필수 페이지: 소개/개인정보처리방침/문의) ===
SITE_NAME=               # 블로그 이름 (예: 생활가전 리뷰)
SITE_OWNER=              # 운영자 이름/닉네임
SITE_EMAIL=              # 문의용 이메일 (실제 동작하는 주소)
# [선택] 티스토리가 WordPress와 이름/운영자/이메일이 다를 때만 입력. 비우면 위 SITE_*를 사용한다.
TISTORY_SITE_NAME=
TISTORY_SITE_OWNER=
TISTORY_SITE_EMAIL=

# === 운영 가드레일 (선택, 기본값 있음) ==========================
MONTHLY_LLM_BUDGET_USD=10
POSTS_PER_DAY=1
DASHBOARD_PORT=5000        # 대시보드 포트. 바꾸고 싶으면 다른 번호(예: 8080). 사용 중이면 자동으로 다음 빈 포트 사용
